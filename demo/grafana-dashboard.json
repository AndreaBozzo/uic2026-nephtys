              { "color": "yellow", "value": 0.3 },
              { "color": "green", "value": 0.6 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "1 - (sum(rate(events_published_total[5m])) / sum(rate(events_ingested_total[5m])))",
          "legendFormat": "Reduction",
          "refId": "A"
        }
      ]
    }
  ],
